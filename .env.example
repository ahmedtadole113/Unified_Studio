# ==========================================================
# Unified Engineering Studio — Environment Configuration
# ==========================================================

# Control Plane & Security (Override secrets before production use)
UES_APP_NAME=Unified Engineering Studio
UES_AUTH_SECRET=change_me_to_a_long_random_hmac_secret
UES_BOOTSTRAP_ADMIN_USER=aariz
UES_BOOTSTRAP_ADMIN_PASSWORD=aariz
PORTAL_BACKEND_PORT=8000
PORTAL_FRONTEND_PORT=5173

# Google Gemini AI Copilot (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Data Warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ues_postgres_secret
POSTGRES_DB=synapse_dw
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# MinIO Object Storage (Data Lake)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=ues_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Spark & JupyterLab
JUPYTER_PORT=8888
SPARK_MASTER_PORT=8080

# Apache Airflow
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=ues_airflow_secret

# Redpanda (Kafka) & RabbitMQ
REDPANDA_PORT=9092
REDPANDA_CONSOLE_PORT=8081
RABBITMQ_PORT=5672
RABBITMQ_ADMIN_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Centralized Observability (Grafana anonymous admin disabled)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3010
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ues_grafana_secret
LOKI_PORT=3100
TEMPO_PORT=3200
ALERTMANAGER_PORT=9093
