{
  "uid": "ues-spark-perf",
  "title": "04. Spark Performance & Resources",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Spark Container CPU %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "ues_container_cpu_percent{service_id=\"spark-processing\"}",
          "refId": "A",
          "legendFormat": "{{service_id}} {{container_name}} {{slo_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Spark Container Memory (MB)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      },
      "targets": [
        {
          "expr": "ues_container_memory_mb{service_id=\"spark-processing\"}",
          "refId": "A",
          "legendFormat": "{{service_id}} {{container_name}} {{slo_id}}"
        }
      ]
    }
  ]
}