{
  "uid": "ues-slo-budgets",
  "title": "08. SLOs, SLIs & Error Budgets",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Error Budget Remaining (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "ues_error_budget_remaining_pct",
          "refId": "A",
          "legendFormat": "{{service_id}} {{container_name}} {{slo_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Multi-Window Burn Rate (x)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "ues_slo_burn_rate",
          "refId": "A",
          "legendFormat": "{{service_id}} {{container_name}} {{slo_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Measured SLIs",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "ues_slo_actual_sli",
          "refId": "A",
          "legendFormat": "{{service_id}} {{container_name}} {{slo_id}}"
        }
      ]
    }
  ]
}